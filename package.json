{
  "name": "descreve-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install-all": "npm install && cd server && npm install && cd ../web && npm install",
    "dev": "concurrently \"npm run server\" \"npm run web\"",
    "server": "cd server && npm run dev",
    "web": "cd web && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
