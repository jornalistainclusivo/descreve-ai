# Configuração do Servidor
PORT=3000

# Conexão com Banco de Dados (Prisma / PostgreSQL)
# Substitua USUARIO, SENHA, HOST e NOME_DO_BANCO pelos dados reais
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?schema=public"

# Chave da API do Google Gemini (AI Studio)
GEMINI_API_KEY="Cole_Sua_Chave_Aqui"