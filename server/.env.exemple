# Configuração do Servidor
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Conexão com Banco de Dados (Prisma / PostgreSQL)
# Substitua USUARIO, SENHA, HOST e NOME_DO_BANCO pelos dados reais
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?schema=public"

# Arquitetura AI Gateway (Resiliência e Fallback)
# Defina qual provedor será usado como primário: openai, openrouter1 ou groq
ACTIVE_LLM_PROVIDER="openai"

# Chaves de API necessárias para as camadas de Fallback
OPENAI_API_KEY="sk-..."
OPENROUTER_API_KEY="sk-or-v1-..."
GROQ_API_KEY="gsk-..."